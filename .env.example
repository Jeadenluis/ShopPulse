# Copy this file to ".env" in the project root (same folder as this file) and edit the values.
# NEVER commit or share your real .env file.

# --- Backend ---
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Leave JWT_SECRET empty to use a random secret per run (logins reset when the backend restarts).
# For a stable secret use 32+ random characters.
JWT_SECRET=
STORE_NAME=Your Store

# --- Demo login and sign-up ---
# Leave these empty for the safe default: both are ON in demo mode (in-memory data) and OFF with MySQL.
# SEED_DEMO_USER=true creates the login below even with MySQL. Change DEMO_USER_PASSWORD if you do,
# because the default password is published in the README.
SEED_DEMO_USER=
DEMO_USER_EMAIL=admin@shoppulse.local
DEMO_USER_PASSWORD=Demo@1234
# ALLOW_REGISTRATION=true lets anyone who can reach the app create an account and see all customer data.
# To create your first MySQL account, set it to true, register, then set it back to false and restart.
ALLOW_REGISTRATION=

# --- Demo mode ---
# true = skip MySQL and use in-memory sample data. If MySQL is unreachable the backend falls back automatically.
FORCE_DEMO_MODE=false

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shoppulse_crm

# --- WooCommerce REST API (leave as placeholders to stay in demo data mode) ---
WOOCOMMERCE_STORE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here
